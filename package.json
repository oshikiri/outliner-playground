{
  "name": "outliner-playground",
  "version": "0.1.0",
  "description": "A simple outliner editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config .",
    "knip": "knip",
    "preview": "vite preview",
    "format": "prettier --write . --list-different",
    "pretest": "prettier --check .",
    "check:traceability": "node --experimental-strip-types scripts/check-spec-test-traceability.ts",
    "check:traceability:strict": "node --experimental-strip-types scripts/check-spec-test-traceability.ts --strict",
    "test": "tsc --noEmit && vitest",
    "test:coverage": "tsc --noEmit && vitest run --coverage"
  },
  "author": "oshikiri",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.3",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/preact": "3.2.4",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "10.0.3",
    "globals": "17.4.0",
    "jotai": "2.18.1",
    "jsdom": "29.0.0",
    "knip": "5.86.0",
    "preact": "10.29.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.1",
    "vitest": "4.1.0"
  },
  "browserslist": {
    "production": [
      "last 2 chrome versions",
      "last 2 firefox versions",
      "last 2 edge versions",
      "last 2 safari versions",
      "last 2 ios_saf versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
